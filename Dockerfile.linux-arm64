# syntax=docker/dockerfile:1.7

FROM --platform=linux/amd64 ubuntu:22.04 AS bridge

ARG DEBIAN_FRONTEND=noninteractive
ARG RUST_VERSION=1.75.0
ARG FLUTTER_BRIDGE_VERSION=3.22.3
ARG CARGO_EXPAND_VERSION=1.0.95
ARG FLUTTER_RUST_BRIDGE_VERSION=1.80.1

ENV PATH=/root/.cargo/bin:/opt/flutter/bin:$PATH

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        build-essential ca-certificates curl git unzip wget xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && wget -q "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_BRIDGE_VERSION}-stable.tar.xz" \
        -O /tmp/flutter.tar.xz \
    && tar -C /opt -xf /tmp/flutter.tar.xz \
    && rm /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter \
    && flutter config --no-analytics

WORKDIR /workspace
COPY . .

RUN cargo install cargo-expand --version "$CARGO_EXPAND_VERSION" --locked \
    && cargo install flutter_rust_bridge_codegen \
        --version "$FLUTTER_RUST_BRIDGE_VERSION" --features uuid --locked \
    && sed -i 's/extended_text: 14.0.0/extended_text: 13.0.0/g' flutter/pubspec.yaml \
    && cd flutter && flutter pub get \
    && cd /workspace \
    && flutter_rust_bridge_codegen \
        --rust-input ./src/flutter_ffi.rs \
        --dart-output ./flutter/lib/generated_bridge.dart \
        --c-output ./flutter/macos/Runner/bridge_generated.h \
    && cp ./flutter/macos/Runner/bridge_generated.h ./flutter/ios/Runner/bridge_generated.h


FROM ubuntu:18.04 AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG RUST_VERSION=1.75.0
ARG RUST_TARGET=aarch64-unknown-linux-gnu
ARG CMAKE_VERSION=3.30.6
ARG FLUTTER_VERSION=3.24.5
ARG VCPKG_COMMIT_ID=120deac3062162151622ca4860575a33844ba10b
ARG RUSTDESK_ID_SERVER
ARG RUSTDESK_RELAY_SERVER

ENV VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DEFAULT_TRIPLET=arm64-linux \
    VCPKG_DEFAULT_HOST_TRIPLET=arm64-linux \
    VCPKG_FORCE_SYSTEM_BINARIES=1 \
    PATH=/opt/flutter-elinux/bin:/opt/cmake/bin:/root/.cargo/bin:/usr/local/bin:$PATH

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        autoconf automake bison build-essential ca-certificates clang cmake curl \
        flex g++ gcc git libayatana-appindicator3-dev libasound2-dev \
        libclang-10-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        libgtk-3-dev libpam0g-dev libpulse-dev libssl-dev libtool libva-dev \
        libxcb-randr0-dev libxcb-shape0-dev libxcb-xfixes0-dev libxdo-dev \
        libxfixes-dev llvm-10-dev nasm ninja-build perl pkg-config python3 \
        unzip wget xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q "https://static.rust-lang.org/dist/rust-${RUST_VERSION}-${RUST_TARGET}.tar.gz" \
        -O /tmp/rust.tar.gz \
    && tar -C /tmp -xzf /tmp/rust.tar.gz \
    && "/tmp/rust-${RUST_VERSION}-${RUST_TARGET}/install.sh" \
    && rm -rf /tmp/rust.tar.gz "/tmp/rust-${RUST_VERSION}-${RUST_TARGET}" \
    && mkdir -p /root/.cargo \
    && printf "[source.crates-io]\nregistry = 'https://github.com/rust-lang/crates.io-index'\n" \
        > /root/.cargo/config

RUN wget -q "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-aarch64.tar.gz" \
        -O /tmp/cmake.tar.gz \
    && mkdir -p /opt/cmake \
    && tar -C /opt/cmake -xzf /tmp/cmake.tar.gz --strip-components=1 \
    && rm /tmp/cmake.tar.gz

RUN git clone https://github.com/microsoft/vcpkg "$VCPKG_ROOT" \
    && git -C "$VCPKG_ROOT" checkout "$VCPKG_COMMIT_ID" \
    && "$VCPKG_ROOT/bootstrap-vcpkg.sh" -disableMetrics

WORKDIR /workspace
COPY vcpkg.json ./
COPY res/vcpkg ./res/vcpkg
COPY res/vcpkg-triplets ./res/vcpkg-triplets

RUN "$VCPKG_ROOT/vcpkg" install \
        --triplet "$VCPKG_DEFAULT_TRIPLET" \
        --x-install-root="$VCPKG_ROOT/installed"

COPY . .
COPY --from=bridge /workspace/src/bridge_generated.rs ./src/bridge_generated.rs
COPY --from=bridge /workspace/src/bridge_generated.io.rs ./src/bridge_generated.io.rs
COPY --from=bridge /workspace/flutter/lib/generated_bridge.dart ./flutter/lib/generated_bridge.dart
COPY --from=bridge /workspace/flutter/lib/generated_bridge.freezed.dart ./flutter/lib/generated_bridge.freezed.dart
COPY --from=bridge /workspace/flutter/macos/Runner/bridge_generated.h ./flutter/macos/Runner/bridge_generated.h
COPY --from=bridge /workspace/flutter/ios/Runner/bridge_generated.h ./flutter/ios/Runner/bridge_generated.h

RUN --mount=type=secret,id=rustdesk_server_key \
    RUSTDESK_ID_SERVER="$RUSTDESK_ID_SERVER" \
    RUSTDESK_RELAY_SERVER="$RUSTDESK_RELAY_SERVER" \
    RUSTDESK_SERVER_KEY="$(cat /run/secrets/rustdesk_server_key)" \
    cargo build --locked --lib --jobs 3 \
        --features hwcodec,flutter,unix-file-copy-paste --release \
    && rm -rf target/release/deps target/release/build

RUN wget -q "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
        -O /tmp/flutter.tar.xz \
    && tar -C /opt -xf /tmp/flutter.tar.xz \
    && rm /tmp/flutter.tar.xz \
    && git clone https://github.com/sony/flutter-elinux.git /opt/flutter-elinux \
    && git -C /opt/flutter-elinux fetch --tags \
    && git -C /opt/flutter-elinux reset --hard "$FLUTTER_VERSION" \
    && flutter-elinux doctor -v \
    && flutter-elinux precache --linux \
    && cp -R /opt/flutter/bin/cache/artifacts/engine/linux-x64/shader_lib \
        /opt/flutter-elinux/flutter/bin/cache/artifacts/engine/linux-arm64 \
    && git -C /opt/flutter-elinux/flutter apply \
        /workspace/.github/patches/flutter_3.24.4_dropdown_menu_enableFilter.diff \
    && rm -rf /opt/flutter

ARG DEB_ARCH=arm64
ARG DEB_PACKAGE_NAME=nc-rustdesk
ARG ARCH=aarch64

RUN sed -i 's/flutter build linux --release/flutter-elinux build linux --verbose/g' build.py \
    && sed -i 's/x64\\/release/arm64\\/release/g' build.py \
    && CARGO_INCREMENTAL=0 DEB_ARCH="$DEB_ARCH" DEB_PACKAGE_NAME="$DEB_PACKAGE_NAME" \
        python3 ./build.py --flutter --skip-cargo \
    && mkdir /out \
    && for name in "$DEB_PACKAGE_NAME"*??.deb; do \
        mv "$name" "/out/${name%.deb}-${ARCH}.deb"; \
    done


FROM scratch AS artifact
COPY --from=build /out/ /
